{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md"
  ],
  "permission": {
    "bash": {
      "npm run *": "allow",
      "npx *": "allow",
      "node *": "allow",
      "git *": "allow",
      "curl *": "allow"
    }
  },
  "mcp": {
    "notion": {
      "type": "remote",
      "url": "https://mcp.notion.com/mcp",
      "enabled": true
    }
  },
  "plugins": [
    "@mohak34/opencode-notifier"
  ],
  "pluginConfig": {
    "@mohak34/opencode-notifier": {
      "sound": true,
      "notification": true,
      "suppressWhenFocused": true,
      "minDuration": 5
    }
  }
}